#!/bin/sh
# kubectl: a stand-in for kubectl, for the test of read-cluster-usage.sh and
# for the agent runs of the cluster pass. It never contacts a cluster.
#
# Copyright 2026 Net Ninjas Consulting
# SPDX-License-Identifier: Apache-2.0
#
# It answers the commands of the fixed list in references/fields.md
# ("Command section 3: the cluster commands"), written exactly as there, with
# canned rows for the namespaces of the fleetboard fixture. Anything else
# gets one line that holds the marker FIXTUREVALUE on standard output, and
# exit code 0, so that a command outside the fixed list shows in the output.
#
# The stand-in takes its settings from the environment, which the script
# under test passes on as it is:
#   FAKE_KUBECTL_LOG     a file that gets one line for each run: the number
#                        of arguments, a space, and the arguments joined by
#                        spaces. Unset: no log.
#   FAKE_KUBECTL_ENVLOG  a file that gets the environment of the last run:
#                        "name NAME" for every variable, then
#                        "value NAME=VALUE" for CANARY, KUBECONFIG, KUBERC,
#                        and LC_ALL. Unset: no file.
#   FAKE_KUBECTL_MODE    optional words that change the answers:
#                        no-context        config current-context fails
#                        empty-context     the context answer is empty
#                        blank-context     the context answer is spaces
#                        odd-context       the context name is not a name
#                        no-top            top fails, with text on standard error
#                        no-top-production top fails in fleetboard-production only
#                        no-pods           get pods fails
#                        no-vpa            the VPA query fails
#                        no-hpa            the HPA query fails
#                        kuberc            answers as if kuberc defaults had added
#                                          a column or a header line
#                        read-stdin        log a line read from standard input
#
# The namespaces fleetboard-production, fleetboard-staging, fleetboard-tools,
# dispatch-production, and dispatch-staging hold the fixture's workloads.
# The namespace stand-in-rows holds hostile rows for the test only. Any
# other namespace has no pods.

set -u

if [ -n "${FAKE_KUBECTL_LOG-}" ]; then
  printf '%s %s\n' "$#" "$*" >> "$FAKE_KUBECTL_LOG"
  if [ -n "${FAKE_KUBECTL_MODE-}" ] && case " $FAKE_KUBECTL_MODE " in *" read-stdin "*) true ;; *) false ;; esac; then
    if IFS= read -r line; then printf 'stdin %s\n' "$line" >> "$FAKE_KUBECTL_LOG"; fi
  fi
fi
if [ -n "${FAKE_KUBECTL_ENVLOG-}" ]; then
  {
    env | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/name \1/p'
    for v in CANARY KUBECONFIG KUBERC LC_ALL; do
      printf 'value %s=%s\n' "$v" "$(printenv "$v")"
    done
  } > "$FAKE_KUBECTL_ENVLOG"
fi

mode=${FAKE_KUBECTL_MODE-}
has_mode() {
  case " $mode " in *" $1 "*) return 0 ;; esac
  return 1
}

marker() {
  echo "FIXTUREVALUE: the stand-in kubectl does not know this command"
  exit 0
}

ns=
for a in "$@"; do
  case $a in --namespace=*) ns=${a#--namespace=} ;; esac
done

pods_cols='custom-columns=POD:.metadata.name,CONTAINERS:.spec.containers[*].name,CPU_REQ:.spec.containers[*].resources.requests.cpu,MEM_REQ:.spec.containers[*].resources.requests.memory,CPU_LIM:.spec.containers[*].resources.limits.cpu,MEM_LIM:.spec.containers[*].resources.limits.memory,STATUS_NAMES:.status.containerStatuses[*].name,RESTARTS:.status.containerStatuses[*].restartCount,LAST_END:.status.containerStatuses[*].lastState.terminated.reason'
vpa_cols='custom-columns=VPA:.metadata.name,TARGET_KIND:.spec.targetRef.kind,TARGET:.spec.targetRef.name,MODE:.spec.updatePolicy.updateMode,RECO_CONTAINER:.status.recommendation.containerRecommendations[*].containerName,CPU_TARGET:.status.recommendation.containerRecommendations[*].target.cpu,MEM_TARGET:.status.recommendation.containerRecommendations[*].target.memory,CPU_LOWER:.status.recommendation.containerRecommendations[*].lowerBound.cpu,MEM_LOWER:.status.recommendation.containerRecommendations[*].lowerBound.memory,CPU_UPPER:.status.recommendation.containerRecommendations[*].upperBound.cpu,MEM_UPPER:.status.recommendation.containerRecommendations[*].upperBound.memory'
hpa_cols='custom-columns=HPA:.metadata.name,TARGET_KIND:.spec.scaleTargetRef.kind,TARGET:.spec.scaleTargetRef.name,MIN:.spec.minReplicas,MAX:.spec.maxReplicas,CURRENT:.status.currentReplicas,DESIRED:.status.desiredReplicas,METRIC_TYPE:.spec.metrics[*].type,METRIC:.spec.metrics[*].resource.name,UTILIZATION:.spec.metrics[*].resource.target.averageUtilization'

get_flags="--no-headers --all-namespaces=false --watch=false --watch-only=false --selector= --field-selector= --ignore-not-found=false --output-watch-events=false --show-kind=false --show-labels=false --show-managed-fields=false --label-columns= --subresource= --allow-missing-template-keys=true --request-timeout=20s"
cmd_top="top pod --containers --namespace=$ns --no-headers --all-namespaces=false --selector= --field-selector= --show-swap=false --sum=false --request-timeout=20s"
cmd_pods="get pods --namespace=$ns $get_flags -o $pods_cols"
cmd_vpa="get verticalpodautoscalers.autoscaling.k8s.io --namespace=$ns $get_flags -o $vpa_cols"
cmd_hpa="get horizontalpodautoscalers.autoscaling --namespace=$ns $get_flags -o $hpa_cols"

CR=$(printf '\r')
TAB=$(printf '\t')

